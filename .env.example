# ---------- Frontend (Vite) ----------
# Base URL of the API. In Docker/production behind nginx use: /api
VITE_API_URL=http://localhost:5000/api

# Show the "demo account" button on the login page outside development (true/false)
VITE_SHOW_DEMO_LOGIN=false

# Optional analytics (leave empty to disable)
VITE_GA_ID=
VITE_CLARITY_ID=
