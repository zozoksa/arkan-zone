# ======================================================
#  Arkan Zone API — environment variables
#  Copy to server/.env and fill in. Never commit .env.
# ======================================================

NODE_ENV=development
PORT=5000

# Public URLs (used in emails, payment redirects and webhooks)
CLIENT_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:5000
# Comma-separated allowed origins for CORS (defaults to CLIENT_URL)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173

# ---------- Database ----------
# Development: SQLite file, zero setup.
DB_CLIENT=better-sqlite3
DB_FILENAME=./storage/arkan.sqlite
# Production (PostgreSQL):
# DB_CLIENT=pg
# DATABASE_URL=postgres://user:password@host:5432/arkan
# MySQL also works: DB_CLIENT=mysql2 (npm i mysql2)

# ---------- Auth ----------
# REQUIRED in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Admin account created on first start (change the password after first login)
ADMIN_EMAIL=admin@arkanzone.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=مدير المنصة
# Create demo@arkanzone.com / 123456 (defaults to true outside production)
SEED_DEMO=true

# ---------- Email (SMTP) ----------
# Leave SMTP_HOST empty in development: emails are printed in the API console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Arkan Zone <no-reply@arkanzone.com>
CONTACT_INBOX=hello@arkanzone.com

# ---------- Payments: Paymob (Egypt) ----------
# From Paymob dashboard → Settings / Developers. Leave empty to use the local
# mock payment page (development only).
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
# Comma-separated integration IDs (card, wallet, kiosk...)
PAYMOB_INTEGRATION_IDS=
# ALLOW_MOCK_PAYMENTS=false

# ---------- Video: Bunny Stream ----------
BUNNY_LIBRARY_ID=
# "Token Authentication" key of the library (recommended: prevents link sharing)
BUNNY_TOKEN_KEY=
