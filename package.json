{
  "name": "arkan-zone",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Arkan Zone — Arabic-first e-learning platform prototype (React + Vite + Express)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "npm --prefix server run dev",
