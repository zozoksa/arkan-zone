    "lint": "eslint .",
    "test": "vitest run",
    "test:server": "npm --prefix server test",
    "test:all": "npm test && npm run test:server"
  },
  "dependencies": {
    "lucide-react": "^1.52.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  }
}
